  57          void Task_Load(unsigned int fn,unsigned char tid)
  58          {
  59   1        Task_Stack[tid][TASKDEEP-2]=(unsigned char)(fn&0xFF);//任务的低八位
  60   1        Task_Stack[tid][TASKDEEP-1]=(unsigned char)(fn>>8);//任务的高八位
  61   1        Task_SP[tid]=(unsigned char)&Task_Stack[tid][TASKDEEP-2];//给指针数组记录此时的任务的堆栈地址
